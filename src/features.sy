const int upper = 20;

int transform(int x) {
    int y;
    y = (x + 3) * 2 - x / 2;
    if (x % 2 == 0) {
        y = y + 7;
    } else {
        y = y - 5;
    }
    return y;
}

int main() {
    int data[3];
    int i;
    int sum;
    i = 0;
    sum = 0;
    while (i < 3) {
        data[i] = getint();
        if (data[i] > 0 && data[i] < upper) {
            sum = sum + transform(data[i]);
        } else {
            sum = sum + 1;
        }
        i = i + 1;
    }
    putint(sum);
    return 0;
}
